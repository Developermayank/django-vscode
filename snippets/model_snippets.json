  "get_queryset(): METHOD": {
    "prefix": ["m-get-queryset", "get-queryset", "mdef-getqueryset"],
    "body": [
      "def get_queryset(self):",
      "\treturn super().get_queryset()${1:.filter($0)}"
    ]
  },
  "save(): METHOD": {
    "prefix": ["m-save", "save", "mdef-save"],
    "body": [
      "def save(self, *args, **kwargs):",
      "\t${0:# do something before save}",
      "\tsuper().save(*args, **kwargs)",
      "\t# do something after save",
      ""
    ]
  },
  "asave(): METHOD": {
    "prefix": ["m-asave", "asave", "mdef-asave"],
    "body": [
