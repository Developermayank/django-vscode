{
  "Model: CLASS": {
    "prefix": ["m-model", "model", "mcls-model"],
    "body": [
      "class ${1:Model}(models.Model):",
      "\t$0",
      "\n\tclass Meta:",
      "\t\tverbose_name = \"${1/([A-Z])/${1:/downcase}${2:+ }/g}\"",
      "\tdef __str__(self):",
      "\t\tpass",
      ""
    ],
    "scope": "python"
  },
  "AbstractModel: CLASS": {
    "prefix": ["m-abstract", "abstractmodel", "mcls-abstract"],
    "body": [
      "class $1Abstract(models.Model):",
      "\t$0",
      "\n\tclass Meta:",
      "\t\tabstract = True\n",
      ""
    ]
  },
  "Model Manager: CLASS": {
    "prefix": ["m-manager", "modelmanager", "mcls-manager"],
