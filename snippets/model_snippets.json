    "scope": "python"
  },
  "get_absolute_url(): METHOD": {
    "prefix": ["m-get-absolute-url", "absoluteurl", "mdef-getabsoluteurl"],
    "body": [
      "def get_absolute_url(self):",
      "\t${4:from django.urls import reverse}",
      "\treturn ${1:reverse(\"$2\", kwargs={\"${3:pk}\": self.$3\\})}",
      ""
    ],
    "scope": "python"
  },
