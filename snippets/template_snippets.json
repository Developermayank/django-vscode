{
    "var": {
        "prefix": [ "t-var" ],
        "body": [
            "{{ $1 }}"
        ],
        "include": ["*.html", "*.twig"],
        "description": ""
    },
    "extends:": {
        "prefix": [ "t-extends" ],
        "body": [
            "{% extends ${1:\"${2:template_name}\"} %}"
        ],
        "include": ["*.html", "*.twig"],
        "description": ""
    },
    "include:": {
        "prefix": [ "t-include" ],
        "body": [
            "{% include ${1:\"${2:template_name}\"} %}"
        ],
        "include": ["*.html", "*.twig"],
        "description": ""
    },
    "include-with:": {
        "prefix": [ "t-include-with" ],
        "body": [
            "{% include ${1:\"${2:template_name}\"} with $3 %}"
        ],
        "include": ["*.html", "*.twig"],
        "description": ""
    },
    "autoescape: TAG": {
        "prefix": [ "t-autoescape" ],
        "body": [
            "{% autoescape ${1|on,off|} %}",
            "\t{{ $2 }}",
            "{% endautoescape %}",
        ],
        "include": ["*.html", "*.twig"],
        "description": ""
