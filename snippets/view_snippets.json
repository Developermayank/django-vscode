{
  "View: Method": {
    "prefix": ["v-view"],
    "body": ["def ${1/(.*)/${1:/downcase}/}_view(request):", "\t${0:pass}", ""],
    "scope": "python"
  },
  "Base View: CLASS": {
    "prefix": ["v-base"],
    "body": ["class $1View(View):", "\t${2:pass}", ""],
    "scope": "python"
  },
  "TemplateView: CLASS": {
    "prefix": ["v-template-view"],
    "body": ["class $1View(TemplateView):", "\ttemplate_name = \"$2.html\""],
    "scope": "python"
  },
  "Generic Class Based Views: CLASS": {
    "prefix": [
      "v-generic-class-based",
      "detailview",
      "listview",
      "formview",
      "createview",
      "updateview",
      "deleteview",
      "class-based-view"
    ],
    "body": [
      "class $2${1|DetailView,ListView,FormView,CreateView,UpdateView,DeleteView|}($1):",
      "\tmodel = $2",
      ""
    ],
    "scope": "python"
  },
  "Generic Class Based Views (Date): CLASS": {
    "prefix": [
      "v-generic-date-views",
      "archiveindexview",
      "yeararchiveview",
      "montharchiveview",
      "weekarchiveview",
      "dayarchiveview",
      "todayarchiveview",
      "datedetailview"
    ],
    "body": [
      "class $1${2|ArchiveIndexView,YearArchiveView,MonthArchiveView,WeekArchiveView,DayArchiveView,TodayArchiveView,DateDetailView|}($2):",
      "\tmodel = $1",
      ""
    ],
    "scope": "python"
  },
  "Views Mixin: Inherit": {
    "prefix": ["v-mixin"],
    "body": [
      "${1|ContextMixin,TemplateResponseMixin,SingleObjectMixin,SingleObjectTemplateResponseMixin,MultipleObjectMixin,MultipleObjectTemplateResponseMixin,FormMixin,ModelFormMixin,ProcessFormMixin,DeletionMixin,YearMixin,MonthMixin,DayMixin,WeekMixin,DateMixin,BaseDateListView|}"
    ],
    "scope": "python"
  }
}
